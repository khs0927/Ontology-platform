+class OntologyRegulationDownstream(RegulationDownstream):
+    """Project regulation workspace in Sion. Explicit saves/updates are Jev-gated writes."""
+
+    TOOLS = [
+        {"name": "produce_compliance_report", "description": "Collect advisory regulation evidence through Sion"},
+        {"name": "list_regulation_works", "description": "List saved regulation reviews, optionally by project_id"},
+        {"name": "get_regulation_work", "description": "Read a saved review by work_id"},
+        {"name": "get_regulation_briefing", "description": "Read source-cited Markdown briefing by work_id"},
+        {"name": "save_regulation_work", "description": "Save gateway run_id to project_id; supports dry_run"},
+        {"name": "update_regulation_work", "description": "Update notes/tasks/status by work_id; supports dry_run"},
+    ]
+
+    async def call_tool(self, tool: str, arguments: dict) -> Any:
+        headers = {}
+        token = os.environ.get(self.token_env)
+        if token:
+            headers["Authorization"] = f"Bearer {token}"
+        client = self._client or httpx.AsyncClient(timeout=self.timeout_s)
+        body = dict(arguments)
+        root = self.base_url + "/api/v1/regulation"
+        try:
+            if tool == "produce_compliance_report":
+                r = await client.post(root + "/gateway/report", json=body, headers=headers)
+            elif tool == "list_regulation_works":
+                r = await client.get(root + "/works", params=body, headers=headers)
+            elif tool == "save_regulation_work":
+                r = await client.post(root + "/works", json=body, headers=headers)
+            elif tool in {"get_regulation_work", "get_regulation_briefing", "update_regulation_work"}:
+                work_id = quote(str(body.pop("work_id")), safe="")
+                url = root + "/works/" + work_id
+                if tool == "get_regulation_briefing":
+                    url += "/briefing"
+                r = await (client.post(url, json=body, headers=headers) if tool == "update_regulation_work" else client.get(url, headers=headers))
+            else:
+                raise DownstreamError(f"ontology: unknown tool '{tool}'")
+            if r.status_code >= 400:
+                raise DownstreamError(f"ontology.{tool}: HTTP {r.status_code}")
+            result = r.json() if "application/json" in r.headers.get("content-type", "") else r.text
+            return result["report"] if tool == "produce_compliance_report" else result
+        except (httpx.HTTPError, KeyError, ValueError) as e:
+            raise DownstreamError(f"ontology.{tool}: invalid request or unavailable service") from e
+        finally:
+            if self._client is None:
+                await client.aclose()
+
+
 def build_downstreams(cfg: dict) -> dict[str, Downstream]:
