diff --git a/tests/test_ontology_regulation.py b/tests/test_ontology_regulation.py
new file mode 100644
index 0000000..a0869f9
--- /dev/null
+++ b/tests/test_ontology_regulation.py
@@ -0,0 +1,36 @@
+import json
+
+import httpx
+
+from aec_mcp_router.audit import AuditLog
+from aec_mcp_router.downstream import OntologyRegulationDownstream
+from aec_mcp_router.router import Router
+from test_router import FakeJev
+
+
+async def test_workspace_routes_and_dry_run_gate(tmp_path, monkeypatch):
+    monkeypatch.setenv("SION_API_TOKEN", "synthetic-token")
+    calls = []
+    def handle(request):
+        assert request.headers["authorization"] == "Bearer synthetic-token"
+        body = json.loads(request.content) if request.content else None
+        calls.append((request.method, request.url.path, body))
+        if request.url.path.endswith("/briefing"):
+            return httpx.Response(200, text="# briefing", headers={"content-type": "text/plain"})
+        return httpx.Response(200, json={"saved": not (body or {}).get("dry_run", False)})
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handle)) as client:
+        ds = OntologyRegulationDownstream("http://sion", "SION_API_TOKEN", client=client)
+        cfg = {"downstream": {"regulation_work": {}}, "require_dry_run_first": True}
+        router = Router(cfg, {"regulation_work": ds}, FakeJev(), AuditLog(tmp_path))
+        discovered = await router.list_tools()
+        assert {t["name"]: t["kind"] for t in discovered["regulation_work"]}["regulation_work.save_regulation_work"] == "write"
+        args = {"project_id": "p", "run_id": "r", "title": "x"}
+        assert (await router.call("regulation_work.save_regulation_work", {**args, "dry_run": False}))["blocked"]
+        dry = await router.call("regulation_work.save_regulation_work", args)
+        assert not dry["applied"] and calls[-1][2]["dry_run"] is True
+        saved = await router.call("regulation_work.save_regulation_work", {**args, "dry_run": False})
+        assert saved["applied"] and calls[-1][2]["dry_run"] is False
+        brief = await router.call("regulation_work.get_regulation_briefing", {"work_id": "w"})
+        assert brief["result"] == "# briefing" and calls[-1][1].endswith("/w/briefing")
+        await router.call("regulation_work.update_regulation_work", {"work_id": "w", "notes": "memo", "tasks": []})
+        assert "work_id" not in calls[-1][2] and calls[-1][2]["dry_run"] is True
