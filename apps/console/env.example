# Supabase project (Settings -> API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sion API (server-side only; the browser never calls it directly).
# The API must run with SION_OIDC_ISSUER=https://<project-ref>.supabase.co/auth/v1
SION_API_URL=http://127.0.0.1:8000

# Paddle Billing (Developer tools -> Authentication -> client-side token).
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_...
