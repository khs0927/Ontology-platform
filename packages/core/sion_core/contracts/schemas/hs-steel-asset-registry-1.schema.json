{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khs0927/hs-steel-cad/assets/registry/asset-registry.schema.json",
  "title": "hs-steel-asset-registry/1",
  "description": "Machine-readable registry of every HS-STEEL drawing asset known to hs-steel-cad: legacy files inventoried in assets/manifest.json (root 'legacy') and code-defined drafting/domain standards (root 'repo'). Generated by tools/AssetRegistry; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generator", "regenerate", "roots", "sourceManifest", "categories", "counts", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "hs-steel-asset-registry/1" },
    "generator": { "type": "string" },
    "regenerate": { "type": "string" },
    "check": { "type": "string" },
    "roots": {
      "type": "object",
      "required": ["repo", "legacy"],
      "properties": {
        "repo": { "type": "object", "required": ["description"] },
        "legacy": {
          "type": "object",
          "required": ["description", "env", "envDefault", "rule"],
          "properties": {
            "env": { "const": "HS_STEEL_LEGACY" },
            "envDefault": { "type": "string" },
            "rule": { "type": "string" },
            "description": { "type": "string" }
          }
        }
      }
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "sha256", "fileCount"],
      "properties": {
        "path": { "type": "string" },
        "schema": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fileCount": { "type": "integer", "minimum": 0 }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "count"],
        "properties": {
          "id": { "$ref": "#/$defs/category" },
          "description": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "byCategory"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "byCategory": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "category": {
      "enum": [
        "block", "section-table", "connection-table", "project-defaults", "project-template", "linetype", "font-map",
        "command-alias", "dialog", "tool-palette", "quantity-workbook", "slide", "icon-set", "command-catalog", "plot-spec",
        "reference-doc", "golden-reference", "layer", "text-style", "dim-style", "title-block", "drawing-generator",
        "annotation-standard", "data-table", "standard-option", "rules-catalog", "profile-family", "connection-detail",
        "model-template"
      ]
    },
    "drawingType": { "enum": ["assembly", "part", "plate", "plan", "elevation", "bom", "any"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path", "symbol", "sha256", "size"],
      "properties": {
        "root": { "enum": ["repo", "legacy"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]+$", "description": "POSIX relative path (repo root or legacy root)" },
        "symbol": { "type": ["string", "null"], "description": "C# symbol for code-defined assets" },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "size": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "insertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basePoint", "basePointSource", "units", "scaleRule"],
      "properties": {
        "basePoint": { "oneOf": [{ "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }, { "type": "null" }] },
        "basePointSource": { "enum": ["code", "dwg", "unknown"] },
        "units": { "const": "mm" },
        "scaleRule": { "enum": ["sheet-scale", "paper", "model", null] }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "unit", "default", "required", "enum", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "number", "integer", "boolean", "enum", "point2d", "array", "object"] },
        "unit": { "type": ["string", "null"] },
        "default": {},
        "required": { "type": "boolean" },
        "enum": { "oneOf": [{ "type": "array", "items": { "type": "string" }, "minItems": 1 }, { "type": "null" }] },
        "description": { "type": ["string", "null"] }
      }
    },
    "loader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "note"],
      "properties": {
        "kind": { "enum": ["mcp-tool", "mcp-resource", "csharp", "knowledge-db", "power-cad"] },
        "ref": { "type": "string", "minLength": 1 },
        "note": { "type": ["string", "null"] }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "name", "description", "source", "format", "disposition", "insertion", "parameters", "layer", "tags", "drawingTypes", "loadedBy", "props"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+/.+$" },
        "category": { "$ref": "#/$defs/category" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" },
        "format": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["ingest", "reference", "code"] },
        "insertion": { "oneOf": [{ "$ref": "#/$defs/insertion" }, { "type": "null" }] },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "layer": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "drawingTypes": { "type": "array", "items": { "$ref": "#/$defs/drawingType" }, "uniqueItems": true },
        "loadedBy": { "type": "array", "items": { "$ref": "#/$defs/loader" } },
        "props": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "properties": { "root": { "const": "legacy" } } } } },
          "then": { "properties": { "disposition": { "enum": ["ingest", "reference"] } } },
          "else": { "properties": { "disposition": { "const": "code" } } }
        },
        {
          "if": { "properties": { "category": { "const": "block" } } },
          "then": {
            "required": ["insertion"],
            "properties": {
              "insertion": { "$ref": "#/$defs/insertion" },
              "props": {
                "required": ["blockCategory", "blockName"],
                "properties": {
                  "blockCategory": { "enum": ["frame", "revision", "cover", "table", "note", "mark", "section_mark", "weld", "anchor", "lug", "ladder", "deck", "misc"] }
                }
              }
            }
          }
        }
      ]
    }
  }
}
