{
  "$defs": {
    "Change": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/Geometry"
        },
        "after": {
          "$ref": "#/$defs/Geometry"
        }
      },
      "required": [
        "entity_id",
        "before",
        "after"
      ],
      "title": "Change",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "LINE",
            "LWPOLYLINE",
            "CIRCLE",
            "ARC",
            "UNSUPPORTED"
          ],
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        },
        "radius": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius"
        },
        "start_angle": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Angle"
        },
        "end_angle": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Angle"
        },
        "closed": {
          "default": false,
          "title": "Closed",
          "type": "boolean"
        },
        "coordinate_system": {
          "const": "WCS",
          "default": "WCS",
          "title": "Coordinate System",
          "type": "string"
        },
        "units": {
          "const": "mm",
          "default": "mm",
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Geometry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "patch_id": {
      "title": "Patch Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "simulation_passed",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "native_write_eligible": {
      "const": false,
      "default": false,
      "title": "Native Write Eligible",
      "type": "boolean"
    },
    "affected_ids": {
      "items": {
        "type": "string"
      },
      "title": "Affected Ids",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "title": "Changes",
      "type": "array"
    }
  },
  "required": [
    "patch_id",
    "status",
    "affected_ids",
    "errors",
    "warnings",
    "changes"
  ],
  "title": "PlanReport",
  "type": "object"
}
