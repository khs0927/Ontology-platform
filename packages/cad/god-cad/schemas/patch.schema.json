    "vector_mm": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Vector Mm",
      "type": "array"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
