# Copy to .env in this directory (gitignored) and replace every empty value.
# Do not reuse the PC token or the live PC database URL.
# Do not commit the copied .env.
#
# Shape of the database URL (host 203.0.113.10 is documentation-only; use the copy):
#   postgresql://aec_reader:replace-with-password@203.0.113.10:5432/aec
# Generate a token locally:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Bearer token for the read-only API only. At least 16 random characters.
AEC_READONLY_API_TOKEN=

# Role aec_reader on the restored copy. Not the owner role, not the PC database.
AEC_READONLY_DATABASE_URL=

# Host port on 127.0.0.1. 58010 avoids the PC API port.
AEC_READONLY_HOST_PORT=58010

# Superuser password for postgres-copy.yml only. The API must not use this role.
AEC_COPY_DB_PASSWORD=

# Host port for the copy. 55433 avoids the PC database port.
AEC_COPY_DB_PORT=55433
