# Copy to .env next to compose.yaml (.env is git-ignored) and fill in your own values.
SION_DB_PASSWORD=
# Token -> scopes. Tokens must be at least 16 characters; generate them, e.g. `openssl rand -hex 24`.
# Add "project:<uuid>" scopes to limit a token to projects.
SION_API_TOKENS_JSON={"<generated-admin-token>": ["*"]}

# Optional: install extras into the API image (rag = LightRAG GraphRAG, regulation = ArchOntos).
SION_API_EXTRAS=
# Optional GraphRAG on the same database (needs SION_API_EXTRAS=rag).
SION_GRAPHRAG_EMBED_MODEL=
SION_GRAPHRAG_EMBED_DIM=
SION_GRAPHRAG_EMBED_BASE_URL=
SION_GRAPHRAG_EMBED_API_KEY=
SION_GRAPHRAG_LLM_MODEL=
SION_GRAPHRAG_LLM_BASE_URL=
SION_GRAPHRAG_LLM_API_KEY=
